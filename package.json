{
	"name": "visual-json",
	"displayName": "Visual JSON Editor",
	"description": "Open JSON files in a GUI that looks like the settings page",
	"icon": "./media/icon.png",
	"version": "1.0.0",
	"publisher": "slaugaus",
	"engines": {
		"vscode": "^1.93.0"
	},
	"license": "MIT",
	"categories": [
		"Visualization",
		"Other"
	],
	"keywords": [
		"json",
		"editor"
	],
	"repository": {
		"type": "github",
		"url": "https://github.com/slaugaus/visual-json-editor-vscode"
	},
	"homepage": "https://github.com/slaugaus/visual-json-editor-vscode",
	"bugs": {
		"url": "https://github.com/slaugaus/visual-json-editor-vscode/issues"
	},
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"title": "Visual JSON Editor",
			"properties": {
				"visual-json.outputPrettiness": {
					"type": "number",
					"default": 2,
					"minimum": 0,
					"maximum": 10,
					"description": "Prettify saved JSON files and indent them with this many spaces. (0 to disable)"
				},
				"visual-json.maxFileSize": {
					"type": "number",
					"default": 256,
					"minimum": 0,
					"description": "Maximum file size (in kilobytes) the editor is allowed to open."
				}
			}
		},
		"customEditors": [
			{
				"viewType": "visual-json.mainEditor",
				"displayName": "Visual JSON Editor",
				"selector": [
					{
						"filenamePattern": "*.json"
					}
				],
				"priority": "default"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "bun compile:prod",
		"compile": "bun lint && bun scripts/build.ts",
		"compile:prod": "bun scripts/build.ts --production",
		"compile:tests": "tsc -p . --outDir out",
		"watch:tests": "tsc -p . -w --outDir out",
		"pretest": "bun compile:tests && bun compile && bun lint",
		"check-types": "tsc --noEmit",
		"lint": "oxfmt --check && oxlint",
		"lint:ci": "oxfmt --check && oxlint --format=github --deny-warnings",
		"test": "vscode-test",
		"ci": "bun scripts/ciVersion.ts && bun lint:ci && vsce package",
		"fix": "oxlint --fix; oxfmt"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.9.6",
		"@types/bun": "1.3.6",
		"@types/mocha": "10.0.10",
		"@types/node": "20.19.30",
		"@types/vscode": "1.93.0",
		"@vscode/codicons": "0.0.36",
		"@vscode/test-cli": "0.0.10",
		"@vscode/test-electron": "2.5.2",
		"@vscode/vsce": "3.7.1",
		"bun": "1.3.6",
		"bun-plugin-solid": "1.0.0",
		"eslint-plugin-jsdoc": "62.9.0",
		"eslint-plugin-solid": "0.14.5",
		"oxfmt": "0.44.0",
		"oxlint": "1.59.0",
		"oxlint-tsgolint": "0.20.0",
		"typescript": "6.0.2"
	},
	"dependencies": {
		"@tauri-apps/api": "2.9.1",
		"lossless-json": "4.3.0",
		"node-html-parser": "6.1.13",
		"solid-js": "1.9.11",
		"zod": "4.3.6"
	}
}
