{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "visual-json",
	"version": "0.1.0",
	"identifier": "cc.slaug.visual-json",
	"build": {
		"beforeDevCommand": "bun run dev:standalone",
		"devUrl": "http://localhost:3000",
		"beforeBuildCommand": "bun run compile:standalone-prod",
		"frontendDist": "../dist-standalone"
	},
	"app": { "windows": [{ "title": "Visual JSON Editor" }], "security": { "csp": null } },
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
