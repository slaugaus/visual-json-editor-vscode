{
	"$schema": "https://biomejs.dev/schemas/2.3.12/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		},
		"enabled": true
	},
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"formatter": {
		"expand": "never",
		"lineEnding": "lf",
		"lineWidth": 90
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"jsxQuoteStyle": "single",
			"operatorLinebreak": "before",
			"quoteStyle": "single",
			"trailingCommas": "all"
		},
		"parser": {
			"jsxEverywhere": false
		}
	},
	"json": {
		"formatter": {
			"expand": "auto"
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"useGenericFontNames": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.ts"]
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
