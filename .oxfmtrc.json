{
	"arrowParens": "avoid",
	"bracketSameLine": true,
	"endOfLine": "lf",
	"ignorePatterns": ["dist*/**", "gen/**", "target/**"],
	"jsdoc": true,
	"jsxSingleQuote": true,
	"objectWrap": "collapse",
	"printWidth": 90,
	"proseWrap": "always",
	"singleQuote": true,
	"sortImports": true,
	"sortPackageJson": false,
	"useTabs": true,
	"overrides": [
		{
			"files": ["*.json"],
			"options": {
				"objectWrap": "preserve"
			}
		},
		{
			"files": ["*.css"],
			"options": {
				"singleQuote": false
			}
		}
	]
}
