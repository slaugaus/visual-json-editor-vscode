{
	"references": [{ "path": "../common" }],
	"compilerOptions": {
		"composite": true,
		"module": "commonjs",
		"target": "ES2024",
		"lib": ["ES2024"],
		"types": ["node", "vscode"],
		"sourceMap": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@common/*": ["../common/*"]
		},
		"jsx": "preserve",
		"jsxImportSource": "solid-js"
	}
}
