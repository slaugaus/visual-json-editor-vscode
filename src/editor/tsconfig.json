{
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "../../dist",
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext"
	}
}
