{
	"categories": {
		"correctness": "error",
		"perf": "warn",
		"style": "warn",
		"suspicious": "warn"
	},
	"env": {
		"builtin": true
	},
	"ignorePatterns": ["dist*/**", "gen/**", "target/**"],
	"jsPlugins": [
		"eslint-plugin-solid",
		{
			"name": "jsdoc-legacy",
			"specifier": "eslint-plugin-jsdoc"
		}
	],
	"options": {
		"typeAware": true,
		"typeCheck": true
	},
	"overrides": [
		{
			"files": ["scripts/**", "**/test/**", "src/extension/**", "src/common/**"],
			"rules": {
				"import/no-nodejs-modules": "off"
			}
		}
	],
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"oxc",
		"jsx-a11y",
		"import",
		"promise",
		"jsdoc"
	],
	"rules": {
		"capitalized-comments": "off",
		"func-style": [
			"error",
			"expression",
			{
				"allowArrowFunctions": true,
				"overrides": {
					"namedExports": "declaration"
				}
			}
		],
		"id-length": [
			"warn",
			{
				"checkGeneric": false,
				"exceptions": ["_"]
			}
		],
		"import/exports-last": "off",
		"import/group-exports": "off",
		"import/no-named-export": "off",
		"import/no-namespace": [
			"error",
			{
				"ignore": ["vscode"]
			}
		],
		"jsdoc-legacy/no-types": "warn",
		"jsdoc-legacy/require-description": "warn",
		// TODO: hopefully they deprecate more rules from legacy
		"jsdoc-legacy/require-jsdoc": [
			"warn",
			{
				"publicOnly": true
			}
		],
		// JSDoc pedantic
		// "jsdoc/require-param": "warn",
		// "jsdoc/require-param-description": "warn",
		"jsdoc/require-param-name": "warn",
		// "jsdoc/require-returns": "warn",
		// "jsdoc/require-returns-description": "warn",
		"jsdoc/require-yields": "warn",
		"max-statements": ["warn", 20],
		"new-cap": "off",
		"no-duplicate-imports": [
			"warn",
			{
				"allowSeparateTypeImports": true
			}
		],
		"no-magic-numbers": "off",
		"no-ternary": "off",
		// Solid TS recommendations @ plugin 0.14.5
		// (node_modules/eslint-plugin-solid/src/configs/typescript.ts)
		// reactivity
		"solid/components-return-once": "warn",
		"solid/event-handlers": "warn",
		// these rules are mostly style suggestions
		"solid/imports": "warn",
		// identifier usage is important
		"solid/jsx-no-duplicate-props": "error",
		"solid/jsx-no-script-url": "error",
		// TS specific
		"solid/jsx-no-undef": [
			"error",
			{
				"typescriptEnabled": true
			}
		],
		"solid/jsx-uses-vars": "error",
		"solid/no-array-handlers": "off",
		"solid/no-destructure": "error",
		// security problems
		"solid/no-innerhtml": "error",
		// only necessary for resource-constrained environments
		"solid/no-proxy-apis": "off",
		"solid/no-react-deps": "warn",
		"solid/no-react-specific-props": "warn",
		// namespaces taken care of by TS
		"solid/no-unknown-namespaces": 0,
		// deprecated
		"solid/prefer-classlist": "off",
		"solid/prefer-for": "error",
		// handled by Solid compiler, opt-in style suggestion
		"solid/prefer-show": "off",
		"solid/reactivity": "warn",
		"solid/self-closing-comp": "warn",
		"solid/style-prop": "warn",
		"sort-imports": "off",
		"sort-keys": "off",
		"sort-vars": "off",
		"typescript/consistent-type-definitions": ["warn", "type"],
		"typescript/explicit-function-return-type": "off",
		"typescript/parameter-properties": [
			"warn",
			{
				"prefer": "parameter-property"
			}
		],
		"unicorn/filename-case": [
			"error",
			{
				"cases": {
					"camelCase": true,
					"pascalCase": true
				}
			}
		],
		// Nice in theory but it doesn't account for external types defined as ... | null
		"unicorn/no-null": "off",
		// False-positives on vscode.postMessage
		"unicorn/require-post-message-target-origin": "off",
		"unicorn/switch-case-braces": "off"
	}
}
